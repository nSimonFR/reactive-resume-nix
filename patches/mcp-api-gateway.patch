diff -ruN a/packages/mcp/src/gateway.test.ts b/packages/mcp/src/gateway.test.ts
--- /dev/null
+++ b/packages/mcp/src/gateway.test.ts
@@ -0,0 +1,89 @@
+import type { MCP_ROUTER } from "./parity";
+import type { RouterClient } from "@orpc/server";
+import type { RequestAuthentication } from "@reactive-resume/api/context";
+import { expect, it } from "vite-plus/test";
+import { Client } from "@modelcontextprotocol/sdk/client/index.js";
+import { InMemoryTransport } from "@modelcontextprotocol/sdk/inMemory.js";
+import { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
+import { registerApiGateway } from "./gateway";
+import { registerParityTools } from "./parity";
+
+const authentication: RequestAuthentication = {
+	user: {
+		id: "owner",
+		name: "Owner",
+		email: "owner@example.test",
+		emailVerified: true,
+		createdAt: new Date(0),
+		updatedAt: new Date(0),
+	},
+	method: "bearer",
+	permissions: ["read", "write", "delete"],
+};
+
+async function connect(expose: boolean, calls: unknown[] = []) {
+	const server = new McpServer({ name: "gateway-test", version: "1.0.0" });
+	const apiClient = {
+		resume: { listVersions: async (input: unknown) => (calls.push(input), [{ id: "v1" }]) },
+	} as unknown as RouterClient<typeof MCP_ROUTER>;
+	registerApiGateway(
+		server,
+		(target) =>
+			registerParityTools(target, apiClient, new Headers(), {
+				authentication,
+				resHeaders: new Headers(),
+				locale: "en-US",
+				trustedClient: "127.0.0.1",
+			}),
+		{ expose },
+	);
+	const client = new Client({ name: "gateway-client", version: "1.0.0" });
+	const [clientTransport, serverTransport] = InMemoryTransport.createLinkedPair();
+	await server.connect(serverTransport);
+	await client.connect(clientTransport);
+	return client;
+}
+
+it("lists api_search and api_execute instead of the api_* tools", async () => {
+	const client = await connect(true);
+	const names = (await client.listTools()).tools.map((tool) => tool.name);
+	expect(names).toContain("api_search");
+	expect(names).toContain("api_execute");
+	expect(names).toContain("open_account_settings");
+	expect(names.filter((name) => name.startsWith("api_")).sort()).toEqual(["api_execute", "api_search"]);
+});
+
+it("lists no api_* tool when not exposed", async () => {
+	const client = await connect(false);
+	const names = (await client.listTools()).tools.map((tool) => tool.name);
+	expect(names.filter((name) => name.startsWith("api_"))).toEqual([]);
+	expect(names).toContain("open_account_settings");
+});
+
+it("finds an operation with its input schema, then runs it", async () => {
+	const calls: unknown[] = [];
+	const client = await connect(true, calls);
+	const search = await client.callTool({ name: "api_search", arguments: { query: "resume versions list" } });
+	const tools = (search.structuredContent as { tools: { name: string; inputSchema: unknown }[] }).tools;
+	const listVersions = tools.find((tool) => tool.name.includes("list_versions"));
+	expect(listVersions?.inputSchema).toMatchObject({ type: "object" });
+
+	const run = await client.callTool({
+		name: "api_execute",
+		arguments: { name: listVersions?.name, arguments: { resumeId: "00000000-0000-0000-0000-000000000000" } },
+	});
+	expect(run.isError).toBeFalsy();
+	expect(calls).toHaveLength(1);
+	expect(run.structuredContent).toEqual({ items: [{ id: "v1" }] });
+});
+
+it("rejects unknown operations and invalid arguments", async () => {
+	const client = await connect(true);
+	const unknown = await client.callTool({ name: "api_execute", arguments: { name: "api_nope" } });
+	expect(unknown.isError).toBe(true);
+	const invalid = await client.callTool({
+		name: "api_execute",
+		arguments: { name: "api_resume_list_versions", arguments: { resumeId: 42 } },
+	});
+	expect(invalid.isError).toBe(true);
+});
diff -ruN a/packages/mcp/src/gateway.ts b/packages/mcp/src/gateway.ts
--- /dev/null
+++ b/packages/mcp/src/gateway.ts
@@ -0,0 +1,110 @@
+import type { McpServer } from "@modelcontextprotocol/sdk/server/mcp.js";
+import type { CallToolResult } from "@modelcontextprotocol/sdk/types.js";
+import { toJsonSchemaCompat } from "@modelcontextprotocol/sdk/server/zod-json-schema-compat.js";
+import z from "zod";
+import { READ_IDEMPOTENT, WRITE_DESTRUCTIVE_EXTERNAL } from "./annotations";
+import { PARITY_TOOL_META } from "./parity";
+import { json } from "./results";
+
+/**
+ * MCP_API_TOOLS: unset lists every api_* tool (upstream), "search" serves them through
+ * api_search + api_execute, "false" drops them. The api_* tools are ~0.7 MB of tools/list.
+ */
+export function apiToolsMode(): "all" | "search" | "none" {
+	const value = process.env.MCP_API_TOOLS;
+	return value === "search" ? "search" : value === "false" ? "none" : "all";
+}
+
+export const isApiTool = (name: string) => name.startsWith("api_");
+
+const searchTitle = "Search the Reactive Resume API";
+const executeTitle = "Run a Reactive Resume API operation";
+
+export const API_GATEWAY_TOOL_META = {
+	api_search: {
+		title: searchTitle,
+		description:
+			"Find Reactive Resume API operations beyond the dedicated tools (resume versions, AI, career profile and facts, cover letter versions, documents, statistics, agent threads, AI providers…) by keywords. Returns each match's name, description and input JSON Schema; run one with api_execute.",
+		inputSchema: z.object({
+			query: z.string().describe("Keywords, e.g. 'resume versions' or 'career facts'."),
+			limit: z.number().int().min(1).max(20).optional().describe("Most matches to return, default 8."),
+		}),
+		outputSchema: z.object({
+			tools: z.array(
+				z.object({ name: z.string(), title: z.string(), description: z.string(), inputSchema: z.unknown().optional() }),
+			),
+		}),
+		annotations: { title: searchTitle, ...READ_IDEMPOTENT },
+	},
+	api_execute: {
+		title: executeTitle,
+		description:
+			"Run an operation found with api_search, by its name. `arguments` must match that operation's input schema.",
+		inputSchema: z.object({
+			name: z.string().describe("Operation name from api_search, e.g. api_resume_list_versions."),
+			arguments: z.record(z.string(), z.unknown()).optional(),
+		}),
+		outputSchema: z.looseObject({}),
+		annotations: { title: executeTitle, ...WRITE_DESTRUCTIVE_EXTERNAL },
+	},
+};
+
+function searchApiTools(query: string, limit = 8) {
+	const words = query.toLowerCase().split(/[^a-z0-9]+/).filter(Boolean);
+	const scored = Object.entries(PARITY_TOOL_META)
+		.filter(([name]) => isApiTool(name))
+		.map(([name, meta]) => {
+			const haystack = `${name.replaceAll("_", " ")} ${meta.title} ${meta.description}`.toLowerCase();
+			const score = words.reduce((total, word) => total + (name.includes(word) ? 3 : haystack.includes(word) ? 1 : 0), 0);
+			return { name, meta, score };
+		})
+		.filter(({ score }) => score > 0)
+		.sort((a, b) => b.score - a.score || a.name.localeCompare(b.name))
+		.slice(0, limit);
+	return scored.map(({ name, meta }) => ({
+		name,
+		title: meta.title,
+		description: meta.description,
+		inputSchema: toJsonSchemaCompat(meta.inputSchema as z.ZodType, { strictUnions: true, pipeStrategy: "input" }),
+	}));
+}
+
+type ToolCallback = (args: unknown, extra: unknown) => CallToolResult | Promise<CallToolResult>;
+
+const toolError = (text: string): CallToolResult => ({ isError: true, content: [{ type: "text", text }] });
+
+/**
+ * Runs `register` against a server whose api_* registrations are captured instead of
+ * listed; with `expose`, they are reachable through api_search and api_execute.
+ */
+export function registerApiGateway(
+	server: McpServer,
+	register: (target: McpServer) => void,
+	{ expose }: { expose: boolean },
+) {
+	const handlers = new Map<string, ToolCallback>();
+	const capture = new Proxy(server, {
+		get(target, property, receiver) {
+			if (property !== "registerTool") return Reflect.get(target, property, receiver);
+			return (name: string, meta: unknown, callback: ToolCallback) => {
+				if (isApiTool(name)) handlers.set(name, callback);
+				// biome-ignore lint/suspicious/noExplicitAny: forwards the SDK's overloaded signature unchanged.
+				else (target.registerTool as any)(name, meta, callback);
+			};
+		},
+	});
+	register(capture);
+	if (!expose) return;
+
+	server.registerTool("api_search", API_GATEWAY_TOOL_META.api_search, ({ query, limit }) =>
+		json({ tools: searchApiTools(query, limit) }),
+	);
+	server.registerTool("api_execute", API_GATEWAY_TOOL_META.api_execute, async ({ name, arguments: args }, extra) => {
+		const handler = handlers.get(name);
+		const meta = PARITY_TOOL_META[name];
+		if (!handler || !meta) return toolError(`Unknown operation ${name}. Find one with api_search.`);
+		const parsed = (meta.inputSchema as z.ZodType).safeParse(args ?? {});
+		if (!parsed.success) return toolError(`Invalid arguments for ${name}:\n${z.prettifyError(parsed.error)}`);
+		return handler(parsed.data, extra);
+	});
+}
